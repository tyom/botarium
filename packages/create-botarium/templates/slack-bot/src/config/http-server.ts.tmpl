/**
 * HTTP server for /config and /health endpoints
 *
 * Exposes bot configuration schema for the simulator's Settings UI.
 * Runs alongside Slack Bolt (which uses socket mode).
 */

import { createConfigServer, buildConfigResponse } from '@botarium/config'
import { config } from './loader'
import { appLogger } from '../utils/logger'
{{#if isObservability}}
import { getHealthResponse } from '../setup'
{{/if}}

export type { ConfigResponse } from '@botarium/config'

/**
 * Start the config HTTP server on a random available port
 * Returns the server instance with its actual port, or null if failed
 */
export function startConfigServer() {
  return createConfigServer({
    getConfigResponse: () => buildConfigResponse(config),
{{#if isObservability}}
    getHealthResponse,
{{/if}}
    logger: appLogger,
  })
}
